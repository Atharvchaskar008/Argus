# Copy to .env — every value is optional for local development.

# --- Server ---
PORT=8000
# Where the UI lives; OAuth redirects back here.
#   npm run dev: http://localhost:5173 · Docker / single service: http://localhost:8000
#   On Render this defaults to the service URL automatically.
FRONTEND_URL=http://localhost:5173
# Signs session cookies. Leave empty locally (a random key is generated per run);
# set a long random value in production.
SECRET_KEY=

# --- GitHub OAuth (optional: sign in with GitHub and analyse private repositories) ---
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional personal access token: raises GitHub API rate limits for public repositories
GITHUB_TOKEN=

# --- LLM (optional; with no key Argus runs in heuristics-only mode) ---
# Every LLM call goes through OpenRouter: one key, 200+ models. https://openrouter.ai/keys
# Models whose id ends in ":free" cost nothing, which is handy for development.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash

# --- Analysis capacity ---
MAX_REPO_FILES=8000
CLONE_TIMEOUT_SEC=120
